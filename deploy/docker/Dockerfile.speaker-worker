# sastt-speaker-worker — pyannote, 3D-Speaker CAM++, ClearerVoice (spec 11.1).
#
# Diarization, overlap detection, embedding and two-source separation share one
# image because they are used together on the same crop; ASR is deliberately in
# a different image (see Dockerfile.asr-worker for the numpy conflict).
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends python3.11 python3-pip ffmpeg \
 && rm -rf /var/lib/apt/lists/* \
 && ln -sf /usr/bin/python3.11 /usr/bin/python3

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src/ ./src/
RUN pip install --no-cache-dir . "psycopg[binary,pool]" redis \
 && pip install --no-cache-dir \
      "pyannote.audio==4.0.7" \
      modelscope addict \
      clearvoice \
 # clearvoice pins numpy<2; install it last so the resolved version stands.
 && pip install --no-cache-dir "numpy<2.0,>=1.24.3"

COPY configs/ ./configs/
COPY model-manifests/ ./model-manifests/

ENV SASTT_ENGINE=real \
    MODELS_DIR=/models \
    HF_HUB_OFFLINE=1 \
    # One worker, one GPU (spec 11.1). Pinning this also stops clearvoice from
    # picking a different device than the rest of the pipeline.
    CUDA_VISIBLE_DEVICES=0

RUN useradd --create-home --uid 10003 sastt
USER sastt

CMD ["python3", "-m", "sastt.workers.offline_worker", \
     "--queues", "speaker.realtime", "speaker.batch", "separation.two_source"]
