# sastt-asr-worker — faster-whisper / CTranslate2 (spec 11.1).
#
# Separate from the speaker worker for the reason spec 11.1 gives: independent
# VRAM budgets, versions and autoscaling. It also keeps a dependency conflict out
# of the picture — clearvoice pins numpy<2 while pyannote 4 wants numpy>=2, so
# the two cannot share one image without one of them being downgraded.
#
# CUDA 12 + cuDNN 9 is what current CTranslate2 requires (spec 19.2).
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends python3.11 python3-pip ffmpeg \
 && rm -rf /var/lib/apt/lists/* \
 && ln -sf /usr/bin/python3.11 /usr/bin/python3

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src/ ./src/
RUN pip install --no-cache-dir . "psycopg[binary,pool]" redis boto3 \
 && pip install --no-cache-dir faster-whisper

COPY configs/ ./configs/
COPY model-manifests/ ./model-manifests/

# Spec 0.3 / 11.2: weights are pre-staged and mounted read-only. A production
# worker never downloads a checkpoint at startup.
ENV SASTT_ENGINE=real \
    MODELS_DIR=/models \
    HF_HUB_OFFLINE=1

RUN useradd --create-home --uid 10002 sastt
USER sastt

CMD ["python3", "-m", "sastt.workers.offline_worker", \
     "--queues", "asr.realtime", "asr.batch"]
