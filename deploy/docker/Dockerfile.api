# sastt-api — FastAPI, validation, auth integration, WebSocket ingest (spec 11.1).
#
# CPU only on purpose: the API must never hold a GPU, so ingest stays responsive
# while the workers do the model work.
FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

# ffmpeg decodes and probes every accepted container of spec 1.1.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src/ ./src/
RUN pip install --no-cache-dir ".[api]" "psycopg[binary,pool]" redis

COPY configs/ ./configs/
COPY model-manifests/ ./model-manifests/
COPY web/ ./web/

# Unprivileged: the API only ever reads its config and the model manifests.
RUN useradd --create-home --uid 10001 sastt
USER sastt

EXPOSE 8000

# Readiness reports engine, config version and which backends are pinned.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=3).status==200 else 1)"

CMD ["uvicorn", "--factory", "sastt.api.http:create_app", \
     "--host", "0.0.0.0", "--port", "8000", "--app-dir", "src"]
